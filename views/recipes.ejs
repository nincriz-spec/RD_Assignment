<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>Recipes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <%- include('partials/navbar') %>
    <div class="container mt-4">
        <h1>All Recipes</h1>
        <a href="/recipes/new" class="btn btn-primary mb-3">+ Add New Recipe</a>

        <ul class="list-group">
            <% recipes.forEach(function (recipe) { %>
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <strong><%= recipe.title %></strong><br>
                        <small class="text-muted">
                            <%= recipe.cuisine_name %> · <%= recipe.email %>
                        </small><br>
                        <small class="text-muted">
                            Created: <%= new Date(recipe.date_created).toISOString()%>
                            · Updated: <%= new Date(recipe.last_updated).toISOString()%>
                        </small>
                    </div>
                    <div class="d-flex gap-2">
                        <a href="/recipes/<%= recipe.recipe_id %>/edit" class="btn btn-success btn-sm">Edit</a>
                        <form action="/recipes/<%= recipe.recipe_id %>/delete" method="POST" class="m-0">
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </li>
            <% }); %>
        </ul>
    </div>
</body>
</html>