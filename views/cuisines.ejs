<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Cuisines</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
</head>

<body>
     <%- include('partials/navbar') %>
    <div class="container mt-4">
        <h1>All Cuisines</h1>

        <a href="/cuisines/create" class="btn btn-primary mb-3">+ Add New Cuisine</a>

        <ul class="list-group"><% cuisines.forEach(function (cuisine) { %>
            <li class="list-group-item d-flex justify-content-between align-items-center"><%= cuisine.name %>
        
        <div class="d-flex gap-2">
        <a href="/cuisines/<%= cuisine.cuisine_id %>/edit" class="btn btn-success btn-sm">Edit</a>

        <form action="/cuisines/<%= cuisine.cuisine_id %>/delete" method="POST" class="m-0">
            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                </form>
                </div>
                </li>
             <% }); %>
        </ul>
    </div>
</body>

</html>