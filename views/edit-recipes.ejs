<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Recipe</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container mt-4" style="max-width: 700px;">
        <h1 class="mb-4">Edit Recipe</h1>

        <form action="/recipes/<%= recipe.recipe_id %>" method="POST">

            <div class="mb-3">
                <label class="form-label">Title</label>
                <input
                    type="text"
                    class="form-control"
                    name="title"
                    value="<%= recipe.title %>"
                    required>
            </div>

            <div class="mb-3">
                <label class="form-label">Instructions</label>
                <textarea
                    class="form-control"
                    name="instructions"
                    rows="6"
                    required><%= recipe.instructions %></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">Cuisine</label>
                <select class="form-select" name="cuisine_id" required>
                    <% cuisines.forEach(function (cuisine) { %>
                        <option
                            value="<%= cuisine.cuisine_id %>"
                            <%= cuisine.cuisine_id === recipe.cuisine_id ? 'selected' : '' %>>
                            <%= cuisine.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">User</label>
                <select class="form-select" name="user_id" required>
                    <% users.forEach(function (user) { %>
                        <option
                            value="<%= user.user_id %>"
                            <%= user.user_id === recipe.user_id ? 'selected' : '' %>>
                            <%= user.email %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">Update</button>
            <a href="/recipes" class="btn btn-secondary">Back to List</a>
        </form>
    </div>
</body>
</html>