<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Search Recipes</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>
    <%- include('partials/navbar') %>
    <div class="container mt-4">
        <h1>Search Recipes</h1>

        <form action="/recipes/search/results" method="GET" class="mb-4">
            <div class="mb-3">
                <label class="form-label">Title</label>
                <input class="form-control" type="text" name="title" value="<%= query.title || '' %>">
            </div>

            <div class="mb-3">
                <label class="form-label">Cuisine</label>
                <select class="form-select" name="cuisine_id">
                    <option value="">-- Any cuisine --</option>
                    <% cuisines.forEach(function (cuisine) { %>
                        <option value="<%= cuisine.cuisine_id %>"
                            <%= String(cuisine.cuisine_id) === String(query.cuisine_id) ? 'selected' : '' %>>
                            <%= cuisine.name %>
                        </option>
                    <% }); %>
                </select>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Created date</label>
                    <input class="form-control" type="date" name="date_created" value="<%= query.date_created || '' %>">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Last updated date</label>
                    <input class="form-control" type="date" name="last_updated" value="<%= query.last_updated || '' %>">
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Search</button>
                <a href="/recipes/search" class="btn btn-secondary">Clear</a>
            </div>
        </form>

        <hr>

        <% if (results === null) { %>
            <p class="text-muted"><em>Fill in any combination of fields and click Search.</em></p>
        <% } else if (results.length === 0) { %>
            <p class="text-muted">No recipes matched your search.</p>
        <% } else { %>
            <h2 class="h4 mb-3">Results (<%= results.length %>)</h2>

            <ul class="list-group">
                <% results.forEach(function (recipe) { %>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div>
                            <div class="fw-bold"><%= recipe.title %></div>
                            <div class="text-muted small">
                                <%= recipe.cuisine_name %> &middot; <%= recipe.user_email %>
                            </div>
                            <div class="text-muted small">
                                Created <%= new Date(recipe.date_created).toISOString() %>
                                <% if (recipe.last_updated &&
                                      new Date(recipe.last_updated).toISOString() !==
                                      new Date(recipe.date_created).toISOString()) { %>
                                    &middot; Updated <%= new Date(recipe.last_updated).toISOString() %>
                                <% } %>
                            </div>
                        </div>
                        <a href="/recipes/<%= recipe.recipe_id %>/edit"
                           class="btn btn-sm btn-outline-primary">Edit</a>
                    </li>
                <% }); %>
            </ul>
        <% } %>

        <p class="mt-4"><a href="/recipes">Back to all recipes</a></p>
    </div>
</body>

</html>